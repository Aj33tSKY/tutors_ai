# New runtime only. Copy to .env.portable.local; use development resources.
# Keep the existing Next .env.local unchanged during extraction.
APP_WEB_ORIGIN=http://localhost:5173
APP_COMMIT_SHA=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use database hostnames reachable from inside a container when using Compose.
# The worker role must not own schema migrations or have access to auth.users.
APP_JOBS_DATABASE_URL=
# Put APP_JOBS_MIGRATION_DATABASE_URL in a separate .env.jobs-migrate.local file
# for the one-off release command. Never load it into the API/worker environment.
# Frontend build-time value. Blank uses Vite's local proxy / a configured proxy.
VITE_API_ORIGIN=
