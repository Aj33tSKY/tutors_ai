{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The top level is for local development and CI smoke tests only; deployed environments are under "env" and are released
  // by .github/workflows/deploy-cloudflare.yml, which also supplies the per-environment variables with --var.
  // Secrets are set once per environment with `wrangler secret put --env <name>`; see docs/cloudflare-deployment.md.
  "name": "tutors-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./.assets", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": ["/v1/*", "/health/*"] },
  "workers_dev": false,
  "observability": { "enabled": true },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "tutors-jobs-local" }],
    "consumers": [{ "queue": "tutors-jobs-local", "max_batch_size": 1, "max_retries": 3 }]
  },
  "env": {
    "staging": {
      "name": "tutors-staging",
      // Deploying this takes over the hostname from the VPS: that is the staging cutover, never a routine deploy.
      "routes": [{ "pattern": "staging.hybridtutors.co.uk", "custom_domain": true }],
      // Every minute: the sweep (due provider events, recording reconciliation, enqueue transcripts and summaries).
      // Daily: recording expiry. Must match DAILY_CRON in src/jobs.ts.
      "triggers": { "crons": ["* * * * *", "15 3 * * *"] },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "tutors-jobs-staging" }],
        // One job per invocation keeps each well inside the 15-minute limit; max_concurrency bounds database connections.
        "consumers": [{ "queue": "tutors-jobs-staging", "max_batch_size": 1, "max_concurrency": 5, "max_retries": 3, "dead_letter_queue": "tutors-jobs-staging-failed" }]
      }
    },
    "production": {
      "name": "tutors-production",
      "routes": [{ "pattern": "app.hybridtutors.co.uk", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *", "15 3 * * *"] },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "tutors-jobs-production" }],
        "consumers": [{ "queue": "tutors-jobs-production", "max_batch_size": 1, "max_concurrency": 5, "max_retries": 3, "dead_letter_queue": "tutors-jobs-production-failed" }]
      }
    }
  }
}
