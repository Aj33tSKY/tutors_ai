redis:
  address: localhost:6379
api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}
ws_url: wss://${LIVEKIT_DOMAIN}
# Egress refuses a job when its estimated CPU cost would exceed the machine.
# The default cost for a track job (1.0) assumes transcoding, but the app
# records screen shares as PASSTHROUGH (no decode or re-encode), which LiveKit
# documents as cheap enough for hundreds per instance. Left at the default, a
# 3-4 vCPU server would turn away the second concurrent call's screen share.
cpu_cost:
  track_cpu_cost: 0.2
