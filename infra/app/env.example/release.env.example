# Release-only environment: used by the explicit `release` profile, never by API or worker.
# Copy to env/jobs-migration.env on the host, mode 0600. Values are never committed.

# Job schema owner connection used only by the explicit release migration command.  [secret]
APP_JOBS_MIGRATION_DATABASE_URL=

# Name of the restricted worker login that the release re-grants private functions to after each migration.
APP_JOBS_RUNTIME_ROLE=

# Name of the webhook-intake login (execute on one function only) that the release re-grants after each migration.
APP_EVENTS_ROLE=
