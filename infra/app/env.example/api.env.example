# API container environment (generated from config/required-env.json).
# Copy to env/api.env on the host, mode 0600. Values are never committed.

# Supabase project REST endpoint. Differs per environment.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase key; RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 S3 endpoint (https://<account-id>.r2.cloudflarestorage.com) for session recordings.
R2_ENDPOINT=

# Private R2 bucket holding session recordings. Separate bucket per environment.
R2_BUCKET=

# R2 API token key id, scoped to the recordings bucket. LiveKit Egress writes with it; the app signs and deletes with it.  [secret]
R2_ACCESS_KEY_ID=

# Pairs with the R2 access key id.  [secret]
R2_SECRET_ACCESS_KEY=

# LiveKit project websocket URL, also the host the server SDK derives.
NEXT_PUBLIC_LIVEKIT_URL=

# Mints room tokens, starts egress, verifies webhook signatures.  [secret]
LIVEKIT_API_KEY=

# Pairs with the LiveKit API key. Can mint a token for any room in its project.  [secret]
LIVEKIT_API_SECRET=

# Invoicing. Test mode on staging, live mode on production.  [secret]
STRIPE_SECRET_KEY=

# Verifies Stripe webhook signatures. Belongs to one endpoint, so it differs per environment.  [secret]
STRIPE_WEBHOOK_SECRET=

# Exact trusted frontend origin for API CORS, CSRF and authentication redirects.
APP_WEB_ORIGIN=

# Webhook-intake login that can only persist signed provider events (private.accept_provider_event). Never the job or owner credentials.  [secret]
APP_EVENTS_DATABASE_URL=

# Fallback AI Gateway credential, used only when OPENAI_API_KEY is not set; never browser exposed.  [secret]
AI_GATEWAY_API_KEY=

# Direct OpenAI credential for chat, summaries and embeddings. Preferred over the AI Gateway; never browser exposed.  [secret]
OPENAI_API_KEY=
