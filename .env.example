# Provisioned automatically by `vercel integration add supabase` — run `vercel env pull .env.local`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# Vercel AI Gateway — powers the Module 4 revision chatbot (src/app/api/chat)
# Not needed on Vercel deployments (uses OIDC automatically); for local dev
# without `vercel dev`, get a key from the AI Gateway dashboard.
AI_GATEWAY_API_KEY=

# Module 2: WebRTC video (LiveKit Cloud — cloud.livekit.io, no Vercel Marketplace
# listing for it). Live transcription (Deepgram) is not yet wired up.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
DEEPGRAM_API_KEY=

# Module 1: booking payments + tutor payouts (Stripe Checkout + Connect Express)
# Provisioned via `vercel integration add stripe` — run `vercel env pull .env.local`.
# STRIPE_WEBHOOK_SECRET is only set automatically once a webhook endpoint exists
# for a real deployment URL; for local testing use the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
