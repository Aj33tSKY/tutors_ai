# Copy development-only values from the tutors-dev project. The local Vercel
# link may point to tutors (production), so do not pull env vars blindly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# Vercel AI Gateway — powers the Module 4 revision chatbot (src/app/api/chat)
# Not needed on Vercel deployments (uses OIDC automatically); for local dev
# without `vercel dev`, get a key from the AI Gateway dashboard.
AI_GATEWAY_API_KEY=

# Module 2: WebRTC video calling + audio-only recording & batch transcription.
# The LiveKit webhook starts one stereo Egress job per call (no video) and
# DEEPGRAM_API_KEY is read directly by that webhook and the transcribe cron.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
# Cloudflare R2 bucket for session recordings (keep it private; see docs/transcription.md).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DEEPGRAM_API_KEY=
# Optional — overrides the Deepgram model (defaults to nova-3) without a redeploy.
DEEPGRAM_MODEL=

# Module 3: post-session summarizer (src/app/api/cron/summarize-sessions),
# scheduled via vercel.ts. Authenticates the cron request; generate any
# random string. Vercel sends this automatically as a Bearer token once the
# same value is set as a project env var — no request-time config needed.
CRON_SECRET=

# Module 1: booking payments + tutor payouts (Stripe Checkout + Connect Express)
# Use Stripe test-mode values for local development and tutors-dev.
# STRIPE_WEBHOOK_SECRET is only set automatically once a webhook endpoint exists
# for a real deployment URL; for local testing use the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
