# Provisioned automatically by `vercel integration add supabase` — run `vercel env pull .env.local`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# Vercel AI Gateway — powers the Module 4 revision chatbot (src/app/api/chat)
# Not needed on Vercel deployments (uses OIDC automatically); for local dev
# without `vercel dev`, get a key from the AI Gateway dashboard.
AI_GATEWAY_API_KEY=

# Module 2: WebRTC video (LiveKit Cloud — cloud.livekit.io, no Vercel Marketplace
# listing for it). DEEPGRAM_API_KEY is only used by agent/ (a separate service,
# see agent/.env.local + agent/README.md) — not read by this Next.js app.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_AGENT_NAME=kindling-transcription
# Supabase Storage > Settings > S3 Connection credentials. Keep the recordings
# bucket private and name it session-recordings.
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_S3_REGION=us-east-1
DEEPGRAM_API_KEY=

# Module 3: post-session summarizer (src/app/api/cron/summarize-sessions),
# scheduled via vercel.ts. Authenticates the cron request; generate any
# random string. Vercel sends this automatically as a Bearer token once the
# same value is set as a project env var — no request-time config needed.
CRON_SECRET=

# Module 1: booking payments + tutor payouts (Stripe Checkout + Connect Express)
# Provisioned via `vercel integration add stripe` — run `vercel env pull .env.local`.
# STRIPE_WEBHOOK_SECRET is only set automatically once a webhook endpoint exists
# for a real deployment URL; for local testing use the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
